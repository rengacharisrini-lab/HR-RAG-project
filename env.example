# Copy this file to ".env" and fill in your real credentials.
# .env is loaded via python-dotenv (load_dotenv()) by app.py, app_with_memory.py, chatbot.py, and ingest.py.
# Do NOT commit a .env with real keys to version control, and never bake it into the Docker image
# (it is already excluded via .dockerignore).

MODEL=gpt-4o-mini

OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1

# Optional: LangSmith tracing (leave LANGCHAIN_TRACING_V2=false to disable)
LANGCHAIN_TRACING_V2=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=hr-rag-chatbot
LANGCHAIN_API_KEY=ls__...
